generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subjects      Subject[]
  decks         Deck[]
  cardReviews   CardReview[]
  studySessions StudySession[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailOtp {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  otpCode      String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("email_otps")
}

model Subject {
  id        String   @id @default(uuid())
  userId    String
  name      String
  colorHex  String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decks     Deck[]

  @@map("subjects")
}

model Deck {
  id          String         @id @default(uuid())
  userId      String
  subjectId   String
  title       String
  description String         @default("")
  colorHex    String         @default("#6366F1")
  isFavorite  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cards         Flashcard[]
  studySessions StudySession[]

  @@map("decks")
}

model Flashcard {
  id               String       @id @default(uuid())
  deckId           String
  question         String
  answer           String
  explanation      String       @default("")
  tags             String[]     @default([])
  cardType         String       @default("standard")
  
  // SM-2 Spaced Repetition Fields
  repetitions      Int          @default(0)
  intervalDays     Int          @default(0)
  easeFactor       Float        @default(2.5)
  nextReviewDate   DateTime     @default(now())
  lastReviewedDate DateTime?
  timesReviewed    Int          @default(0)
  timesForgot      Int          @default(0)
  masteryStatus    String       @default("learning") // learning, reviewing, mastered

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  deck             Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews          CardReview[]

  @@map("flashcards")
}

model CardReview {
  id          String    @id @default(uuid())
  cardId      String
  userId      String
  rating      String    // again, hard, good, easy
  reviewedAt  DateTime  @default(now())

  card        Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("card_reviews")
}

model StudySession {
  id              String    @id @default(uuid())
  userId          String
  deckId          String
  cardsReviewed   Int       @default(0)
  correctCount    Int       @default(0)
  durationSeconds Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck            Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}
