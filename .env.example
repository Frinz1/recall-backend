# Server Configuration
PORT=5000
NODE_ENV=development

# Cloud PostgreSQL Database URL (Works with Supabase, Neon.tech, Railway, or Render Postgres)
DATABASE_URL="postgresql://postgres:password@ep-sample-pooler.us-east-1.aws.neon.tech/recall_db?sslmode=require"

# JWT Authentication
JWT_SECRET="recall_secure_jwt_secret_token_replace_me_in_production"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="*"
